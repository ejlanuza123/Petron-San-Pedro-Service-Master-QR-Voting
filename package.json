{
  "name": "sm-voting-system",
  "version": "1.4.2",
  "description": "QR-Based Voting System for Service Master (SM) of the Month with Fraud Detection & Admin Monitoring",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "client:dev": "npm --prefix client run dev",
    "server:dev": "npm --prefix server run dev",
    "start": "node server/src/index.js",
    "build": "node scripts/build.js",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "test": "node --test server/src/tests/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "qrcode": "^1.5.4"
  },
  "keywords": [
    "qr-voting",
    "service-master",
    "fraud-detection",
    "react",
    "express",
    "tailwind"
  ],
  "author": "Antigravity Engineering",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
